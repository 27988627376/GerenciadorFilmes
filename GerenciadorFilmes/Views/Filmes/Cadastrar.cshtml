@model GerenciadorFilmes.ViewModels.NovoFilmeViewModel

@{
    ViewData["Title"] = "Cadastrar filme";
}

<h1>Cadastrar filme</h1>

<form asp-action="Cadastrar" method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="validation"></div>

    <partial name="_FormularioFilme" model="(GerenciadorFilmes.ViewModels.FilmeFormularioViewModel)Model" />

    <div class="form-actions">
        <button type="submit" class="button">Salvar</button>
        <a asp-action="Index" class="button secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}